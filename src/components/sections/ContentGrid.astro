---
// One flexible N-column grid, no `variant` prop — like StoryMosaic.astro,
// the layout is driven entirely by the `blocks` array's order, each block's
// `span` (grid-column width), and an optional `tone` (surface/muted/inverse
// fill). Four cell types (text, image, icon, feature) cover every wireframe
// this was built from without any special-casing.
//
// Deliberately duplicates StoryMosaic.astro's 2-column text/image job at
// `columns={2}` — that overlap was a conscious call, not an oversight; see
// SECTIONS.md for why it wasn't just reused instead.
//
// Follows Hero.astro's Placeholder-wrapping rule: every <Placeholder> that
// needs this file's own sizing is wrapped in a plain <div> authored here.
import Placeholder from '../ui/Placeholder.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import type { ServiceIconName } from '../ui/ServiceIcon.astro';
import type { ImageMetadata } from 'astro';
import { sectionHeadingTags } from '../../lib/headings';

type Tone = 'surface' | 'muted' | 'inverse';

interface TextBlock {
  type: 'text';
  heading?: string;
  body: string[];
  span?: number;
  tone?: Tone;
}

interface ImageCellBlock {
  type: 'image';
  ratio: string;
  label: string;
  src?: ImageMetadata;
  span?: number;
}

interface IconBlock {
  type: 'icon';
  icon: ServiceIconName;
  span?: number;
  tone?: Tone;
}

interface FeatureBlock {
  type: 'feature';
  icon: ServiceIconName;
  heading: string;
  body: string[];
  span?: number;
  tone?: Tone;
}

type ContentGridBlock = TextBlock | ImageCellBlock | IconBlock | FeatureBlock;

interface Props {
  heading?: string;
  lead?: string;
  /** Default 3. StoryMosaic.astro is the established 2-column text/image component — use `columns={2}` here only when you specifically want it duplicated (see SECTIONS.md), not as the default choice. */
  columns?: number;
  /** Steps in order: each cell becomes an outlined card with a numbered
   *  circle above its heading, and the grid is an <ol>, so the order is in
   *  the markup and not only in the drawn numbers. Meant for text cells. */
  numbered?: boolean;
  blocks: ContentGridBlock[];
}

const { heading, lead, columns = 3, numbered = false, blocks } = Astro.props;

// An ordered list when the cells are numbered steps, plain divs otherwise.
const GridTag = numbered ? 'ol' : 'div';
const CellTag = numbered ? 'li' : 'div';

const { Heading, Subheading } = sectionHeadingTags(heading);

// Build-time random suffix per instance, so two ContentGrids on one page
// cannot share a heading id — the same fix Faq.astro, TagCloud.astro,
// ServiceBlocks.astro, TextBlock.astro and ComparisonTable.astro all
// already carry, for the same reason. This file had kept the literal
// 'content-grid-heading', which was harmless only while no page rendered
// two HEADED instances: four pages (deep-cleaning, end-of-lease,
// mould-cleaning, why-tlb) already run two ContentGrids each, but in every
// case at least one has no `heading` and so renders no id at all.
// work-with-us.astro is the first page with two headed ones, and it shipped
// two elements sharing one id with the second section's `aria-labelledby`
// resolving to the FIRST section's heading. Found by grepping the built
// HTML for duplicate ids, not by reading the source.
const headingId = `content-grid-heading-${Math.random().toString(36).slice(2, 9)}`;

// Discrete modifier classes, not an inline custom property: a mobile
// breakpoint needs to override this per-instance value, and an inline style
// (custom-property-valued or not) always beats a stylesheet rule trying to
// reassign that same property on that same element — found live the same
// way the [hidden]-vs-display bug was, by checking computed styles in a
// real browser rather than trusting the code read. See SECTIONS.md.
const cells = blocks.map((block) => {
  const span = Math.min(block.span ?? 1, columns);
  let tone: Tone | undefined;
  if (block.type === 'text') tone = block.tone ?? 'surface';
  else if (block.type === 'icon') tone = block.tone ?? 'muted';
  else if (block.type === 'feature') tone = block.tone ?? 'surface';
  return { block, span, tone };
});
---

<section class="content-grid" aria-labelledby={heading ? headingId : undefined}>
  <div class="container">
    {heading && (
      <div class="content-grid__intro">
        <Heading id={headingId} class="title-2">{heading}</Heading>
        {lead && <p class="lead">{lead}</p>}
      </div>
    )}

    <GridTag class:list={['content-grid__grid', `content-grid__grid--cols-${columns}`, { 'content-grid__grid--numbered': numbered }]}>
      {cells.map(({ block, span, tone }) => (
        <CellTag
          class:list={[
            'content-grid__cell',
            `content-grid__cell--${block.type}`,
            tone && `content-grid__cell--${tone}`,
            `content-grid__cell--span-${span}`,
          ]}
        >
          {block.type === 'text' && (
            <>
              {block.heading && <Subheading class="title-3">{block.heading}</Subheading>}
              {block.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </>
          )}

          {block.type === 'image' && (
            <div class="content-grid__image">
              <Placeholder ratio={block.ratio} label={block.label} src={block.src} />
            </div>
          )}

          {block.type === 'icon' && <ServiceIcon name={block.icon} class="content-grid__icon" />}

          {block.type === 'feature' && (
            <>
              <ServiceIcon name={block.icon} class="content-grid__icon" />
              <Subheading class="title-3">{block.heading}</Subheading>
              {block.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </>
          )}
        </CellTag>
      ))}
    </GridTag>
  </div>
</section>

<style>
  .content-grid {
    padding-block: var(--space-2xl);
  }

  .content-grid__intro {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .content-grid__intro :is(h2, h3) {
    margin-bottom: var(--space-sm);
  }

  .content-grid__grid {
    display: grid;
    gap: var(--space-lg);
  }

  .content-grid__grid--cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .content-grid__grid--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .content-grid__grid--cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .content-grid__cell {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .content-grid__cell--span-1 {
    grid-column: span 1;
  }

  .content-grid__cell--span-2 {
    grid-column: span 2;
  }

  .content-grid__cell--span-3 {
    grid-column: span 3;
  }

  .content-grid__cell--span-4 {
    grid-column: span 4;
  }

  .content-grid__cell--surface {
    background: var(--color-surface);
    color: var(--color-on-surface);
  }

  .content-grid__cell--muted {
    background: var(--color-surface-muted);
    color: var(--color-on-surface);
  }

  .content-grid__cell--inverse {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
  }

  .content-grid__cell--text,
  .content-grid__cell--feature {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-lg);
  }

  .content-grid__cell--text :is(h3, h4),
  .content-grid__cell--feature :is(h3, h4) {
    font-size: var(--title-6);
  }

  .content-grid__cell--inverse :is(h3, h4) {
    color: var(--color-on-inverse);
  }

  .content-grid__cell--text p,
  .content-grid__cell--feature p {
    font-size: var(--text-small);
    color: var(--color-body);
  }

  .content-grid__cell--inverse p {
    color: var(--color-on-inverse);
  }

  .content-grid__cell--icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
  }

  .content-grid__icon {
    width: 40px;
    height: 40px;
  }

  .content-grid__cell--feature .content-grid__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-xs);
  }

  .content-grid__image {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* `numbered`: outlined cards, each opened by a numbered circle. The number
     is a CSS counter, decorative only: the <ol> already gives the order to
     assistive tech. Cards align to the top, so the circles and headings sit
     on one line across the row however long each body runs. */
  .content-grid__grid--numbered {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: content-grid-step;
  }

  .content-grid__grid--numbered .content-grid__cell {
    counter-increment: content-grid-step;
    justify-content: flex-start;
    border: 1px solid var(--color-border-muted);
  }

  /* A step's heading is a short label under its number, not a cell title:
     one size down, so four across do not wrap to three lines each. */
  .content-grid__grid--numbered .content-grid__cell :is(h3, h4) {
    font-size: var(--title-7);
  }

  .content-grid__grid--numbered .content-grid__cell::before {
    content: counter(content-grid-step);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-sm);
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-inverse);
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-base);
  }

  /* mirrors --bp-lg — 3- and 4-col grids drop to 2; already-2-col grids are
     unaffected. Relies on ordinary cascade source order (this rule appears
     after the --cols-N rules above, so it wins their equal-specificity tie)
     rather than any inline value, which is what actually lets a breakpoint
     override a per-instance layout choice — see the frontmatter comment. */
  @media (max-width: 1025px) {
    .content-grid__grid--cols-3,
    .content-grid__grid--cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .content-grid__grid {
      grid-template-columns: 1fr;
    }

    .content-grid__cell {
      grid-column: span 1;
    }

    .content-grid__cell--text,
    .content-grid__cell--feature,
    .content-grid__cell--icon {
      padding: var(--space-md);
    }
  }
</style>
