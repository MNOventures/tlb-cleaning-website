---
import { sectionHeadingTags } from '../../lib/headings';

// Portrait video block (hub task #62, November 2026). Every TLB reel is
// portrait (9:16), so this shows one beside a short heading and text on
// desktop and stacked under the copy on phones. It behaves like the YouTube
// hero video on /local-care/: the video's own still with a play button, muted
// autoplay once it is in view, "Tap for sound", and back to the still when it
// ends or the visitor scrolls past.
//
// The window is cropped to 4:5 so a portrait reel never towers over the copy.
// The player keeps its real 9:16 shape behind the window and the top and
// bottom are trimmed evenly.
//
// The section only renders when `video.src` holds a YouTube link (an
// /embed/, /shorts/, watch?v= or youtu.be link all work). With no link it
// renders nothing, so pages that still hold an old placeholder slot (deep
// cleaning, end of lease) stay as they are.

interface Props {
  headingLines: string[];
  /** One or two sentences beside the video. Optional. */
  lead?: string;
  video: {
    /** What the video shows. Used as the play button's accessible name. */
    label: string;
    caption?: string;
    /** Kept for older callers; the block is always portrait. */
    ratio?: string;
    /** A YouTube link. Leave empty to hide the section. */
    src?: string;
  };
  /** Which side the video sits on at desktop widths. Default 'right'. */
  videoPosition?: 'left' | 'right';
}

const { headingLines, lead, video, videoPosition = 'right' } = Astro.props;

const { Heading } = sectionHeadingTags(headingLines.join(' '));

const ytId = (() => {
  const src = video.src?.trim();
  if (!src) return null;
  const m = src.match(
    /(?:youtube(?:-nocookie)?\.com\/(?:embed\/|shorts\/|live\/|watch\?(?:[^#]*&)?v=)|youtu\.be\/)([A-Za-z0-9_-]{11})/,
  );
  return m ? m[1] : null;
})();

const headingId = ytId ? `video-feature-${ytId}` : 'video-feature-heading';
---

{ytId && (
<section
  class:list={['video-feature', { 'video-feature--video-left': videoPosition === 'left' }]}
  aria-labelledby={headingId}
>
  <div class="container video-feature__inner">
    <div class="video-feature__copy">
      <Heading id={headingId} class="title-2 video-feature__heading">
        {headingLines.map((line) => (
          <>
            {line}
            <br />
          </>
        ))}
      </Heading>
      {lead && <p class="lead video-feature__lead">{lead}</p>}
      {video.caption && <p class="video-feature__caption">{video.caption}</p>}
    </div>

    <div class="video-feature__media">
      <div class="video-feature__frame">
        <div class="video-feature__yt" data-yt-id={ytId}>
          <img
            class="video-feature__poster"
            src={`https://i.ytimg.com/vi/${ytId}/oardefault.jpg`}
            onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${ytId}/hqdefault.jpg'`}
            alt=""
            width="720"
            height="1280"
            loading="lazy"
          />
          <button type="button" class="video-feature__play" aria-label={`Play: ${video.label}`}>
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          </button>
          <button type="button" class="video-feature__sound">Tap for sound</button>
        </div>
      </div>
    </div>
  </div>
</section>
)}

<style>
  .video-feature__inner {
    padding-block: var(--space-2xl);
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-xl);
    align-items: center;
  }

  .video-feature--video-left .video-feature__copy {
    order: 2;
  }

  .video-feature--video-left .video-feature__inner {
    grid-template-columns: 360px 1fr;
  }

  .video-feature__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .video-feature__heading {
    max-width: 22ch;
  }

  .video-feature__lead {
    max-width: 46ch;
  }

  .video-feature__caption {
    font-size: var(--text-small);
    opacity: 0.8;
  }

  .video-feature__media {
    display: flex;
    justify-content: center;
  }

  /* The visible window: 4:5, cropped evenly from the 9:16 player. */
  .video-feature__frame {
    position: relative;
    width: 360px;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #11191c;
  }

  .video-feature__yt {
    position: absolute;
    inset: 0;
  }

  .video-feature__poster,
  .video-feature__yt :global(iframe) {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    transform: translateY(-50%);
    border: 0;
    object-fit: cover;
  }

  .video-feature__yt :global(iframe) {
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .video-feature__yt.is-playing :global(iframe) {
    opacity: 1;
  }

  .video-feature__play {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 72px;
    height: 72px;
    margin: auto;
    display: grid;
    place-items: center;
    padding: 0 0 0 4px;
    border: 0;
    border-radius: 50%;
    background: rgb(17 25 28 / 0.72);
    color: #fff;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .video-feature__play:hover,
  .video-feature__play:focus-visible {
    transform: scale(1.06);
    background: var(--tlb-green, #1f6b4f);
  }

  .video-feature__yt.is-playing .video-feature__play {
    display: none;
  }

  .video-feature__sound {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: var(--space-md, 16px);
    transform: translateX(-50%);
    display: none;
    padding: 8px 16px;
    border: 0;
    border-radius: 999px;
    background: rgb(17 25 28 / 0.78);
    color: #fff;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .video-feature__yt.is-playing.is-muted .video-feature__sound {
    display: block;
  }

  /* mirrors --bp-lg: stack, copy first, video centred under it */
  @media (max-width: 1025px) {
    .video-feature__inner,
    .video-feature--video-left .video-feature__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .video-feature--video-left .video-feature__copy {
      order: 0;
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .video-feature__inner {
      padding-block: var(--space-xl);
    }

    .video-feature__frame {
      width: min(100%, 320px);
    }
  }
</style>

<script>
  // Same behaviour as the YouTube hero video in Hero.astro: muted autoplay
  // once 60% in view, "Tap for sound" while muted, back to the still when it
  // ends or scrolls out of view. The YouTube player script loads only when a
  // page has one of these, and is shared with the hero if both are present.
  const blocks = document.querySelectorAll<HTMLElement>('.video-feature__yt');
  if (blocks.length) {
    const w = window as any;
    let apiReady: Promise<void> | null = null;
    const loadApi = () =>
      (apiReady ??= new Promise<void>((resolve) => {
        if (w.YT?.Player) return resolve();
        const prev = w.onYouTubeIframeAPIReady;
        w.onYouTubeIframeAPIReady = () => {
          prev?.();
          resolve();
        };
        if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
          const s = document.createElement('script');
          s.src = 'https://www.youtube.com/iframe_api';
          document.head.append(s);
        }
      }));

    blocks.forEach((el) => {
      const id = el.dataset.ytId;
      if (!id) return;
      let player: any = null;
      let autoplayed = false;

      const reset = () => {
        try {
          player?.destroy();
        } catch {}
        player = null;
        el.querySelector('iframe')?.remove();
        el.classList.remove('is-playing', 'is-muted');
      };

      const start = async (muted: boolean) => {
        if (player) {
          if (!muted) {
            player.unMute();
            el.classList.remove('is-muted');
            player.playVideo();
          }
          return;
        }
        await loadApi();
        const holder = document.createElement('div');
        el.append(holder);
        el.classList.toggle('is-muted', muted);
        player = new w.YT.Player(holder, {
          videoId: id,
          host: 'https://www.youtube-nocookie.com',
          playerVars: { autoplay: 1, mute: muted ? 1 : 0, playsinline: 1, rel: 0, controls: 1 },
          events: {
            onReady: (e: any) => {
              if (muted) e.target.mute();
              e.target.playVideo();
            },
            onStateChange: (e: any) => {
              if (e.data === 1) el.classList.add('is-playing');
              if (e.data === 0) reset();
            },
          },
        });
      };

      el.querySelector('.video-feature__play')?.addEventListener('click', () => start(false));
      el.querySelector('.video-feature__sound')?.addEventListener('click', () => start(false));

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.6 && !player && !autoplayed && !reduceMotion) {
                autoplayed = true;
                start(true);
              } else if (!entry.isIntersecting && player) {
                reset();
              }
            }
          },
          { threshold: [0, 0.6] },
        ).observe(el);
      }
    });
  }
</script>
