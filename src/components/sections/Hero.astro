---
// Five variants, one component — extend with a variant value, don't fork:
//  - split-mosaic (default): yellow hero, copy + trust-badge card left, an
//    asymmetric N-image mosaic right. The original/only built variant.
//  - full-width-photo: single full-bleed photo behind the section; a
//    surface-coloured content card floats over it (own solid background, so
//    legibility never depends on the photo's contrast).
//  - split-single-image: two flush half-width panels, one plain image, one
//    copy panel — no brand-colour fill, no mosaic, no trust-badge card.
//    Takes an `imagePosition` ('left' default | 'right') to mirror the two
//    panels rather than forking a near-identical variant — same call as
//    `minimal`'s `align`.
//  - split-collage: copy panel + a static two-column image collage (NOT an
//    interactive carousel, despite the wireframe's label — see SECTIONS.md).
//  - minimal: text-only, no image at all — headline + lead + CTA in a plain
//    panel, for informational pages that don't need a photo. Takes an
//    `align` ('left' default | 'center') and an optional `stats` row rather
//    than forking a sixth variant for what's the same layout family.
//
// IMPORTANT: Astro only stamps an element with THIS component's scoped-style
// attribute when that element is written directly in this file's template.
// A class passed straight into <Placeholder class="…" /> lands on
// Placeholder's own root, under Placeholder's scope, not this one — any
// rule here targeting that class silently never matches. So every
// Placeholder that needs sizing/position from this file's <style> is wrapped
// in a plain <div> authored right here, and the rule targets the wrapper.
// (This was found live: an unwrapped .hero__logo defaulted to Placeholder's
// own width:100%, which blew out a 1fr/1fr grid to ~10/90 before the fix.)
import Placeholder from '../ui/Placeholder.astro';
import Button from '../ui/Button.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import { breadcrumbTrail } from '../../data/breadcrumbs';
import type { ImageBlock, MosaicImage, ButtonData } from '../../data/types';

type Variant = 'split-mosaic' | 'full-width-photo' | 'split-single-image' | 'split-collage' | 'minimal';

interface HeroStat {
  value: string;
  caption: string;
}

interface Props {
  variant?: Variant;
  /** Short eyebrow label rendered ABOVE the <h1>, outside it — e.g. "WHY TLB".
   *  Deliberately not folded into `headingLines`: those all render inside the
   *  single page <h1>, so a kicker there would become part of the heading text
   *  ("WHY TLB Nine local mums…"), which is wrong semantically and visually.
   *  Same idea PhotoGallery.astro's `story` steps already have as `step`. */
  kicker?: string;
  headingLines: string[];
  /** One line rendered directly BENEATH the <h1>, above the lead — a demoted
   *  headline, not an eyebrow. Added September 2026 for the three copy-rewrite
   *  briefs (airbnb, real estate, NDIS), each of which replaces the H1 with the
   *  mapped keyword phrase and keeps the old headline one line lower rather
   *  than cutting it: "Set and forget hosting starts here.", "Stop chasing
   *  cleaners between tenancies.", "The same trusted local faces, treating your
   *  home with genuine care."
   *
   *  Distinct from `kicker`, which sits ABOVE the <h1> and is styled as a small
   *  uppercase label. This is display-sized and sentence-cased, because it is a
   *  sentence that used to be the heading. Outside the <h1> for the same reason
   *  `kicker` is: the page gets one heading, and its text is `headingLines`. */
  subheading?: string;
  lead: string;
  /** The hero's CTA. Rendered as `brand` when the caller doesn't name a
   *  variant — identical to `inverse` at rest (--color-brand and
   *  --color-inverse are both Dark Teal), but it hovers to the Mint accent
   *  instead of inverting to Off White. The hero CTA is the page's primary
   *  action and sits on a light panel, so the accent is the hover it wants. */
  cta: ButtonData;
  /** Small badge/logo above the heading. Optional on every variant. */
  logo?: ImageBlock;
  /** split-mosaic only: trust badges inside the white card under the copy. */
  badges?: ImageBlock[];
  /** split-mosaic only: the asymmetric N-image grid (works with any count >= 1). */
  images?: MosaicImage[];
  /** full-width-photo / split-single-image only: the one hero image. */
  image?: ImageBlock;
  /** split-single-image only: which side the image panel sits on at desktop
   *  widths. Default 'left'. Mobile is unaffected — copy stays above the
   *  image below --bp-lg for both positions. */
  imagePosition?: 'left' | 'right';
  /** full-width-photo / split-single-image only: how `image` fills its panel.
   *  Default 'cover', which is what a photo wants. Use 'contain' for a cut-out
   *  figure on a transparent backdrop — the panel stretches to the copy's
   *  height, so 'cover' crops the sides off a frame that was meant to be seen
   *  whole. Nothing shows in the leftover space; the section's own background
   *  is already what a transparent asset sits on. 'contain-bottom' anchors it
   *  to the panel's bottom edge instead of centring it — for a cut-out whose
   *  subject is flush with the bottom of its own frame, so it stands on the
   *  section edge rather than floating above it. */
  imageFit?: 'cover' | 'contain' | 'contain-bottom';
  /** split-single-image only: which side of a 'cover' image survives the
   *  crop. Default 'center'. The half-width panel is much narrower than a
   *  16/9 file, so a subject near one edge needs this to stay in frame. */
  imageFocus?: 'left' | 'center' | 'right' | `${number}%`;
  /** split-single-image only: how much of the row the photo panel takes at
   *  desktop widths. Default 'default' (an even half). 'wide' gives the photo
   *  a larger share, for a landscape group shot whose people stand near the
   *  edges and would otherwise be cropped off by the half-width panel. Mobile
   *  is unaffected: both collapse to one full-width column below --bp-lg. */
  imageWidth?: 'default' | 'wide';
  /** split-single-image only: an embedded video player in the media panel
   *  instead of `image`. `src` is the player's embed URL (a Google Drive
   *  `/preview` link or a YouTube `/embed/` link), `title` names the iframe
   *  for screen readers, `ratio` is the video's own shape (default '9/16',
   *  a phone-shot reel). The frame keeps that shape inside the panel rather
   *  than stretching to it, because a player letterboxes anything else.
   *  `frame` is an optional, squatter shape for the visible window (say
   *  '4/5' for a 9/16 reel): the player keeps its real shape behind it and
   *  the top and bottom are cropped evenly, so there are no black bars. The
   *  cost is that whatever the player draws in the cropped strips, such as
   *  Drive's control bar, is hidden; clicking the video still plays and
   *  pauses it. */
  video?: { src: string; title: string; ratio?: string; frame?: string };
  /** full-width-photo only: how wide the floating copy card runs at desktop
   *  widths. Default 'default' (480px), which is the width every caller had
   *  before this prop existed — the 56 /locations/<town>/ pages included, so
   *  they are unaffected. 'wide' (640px) is for a card whose heading wants
   *  fewer wrapped lines, or which sits over a landscape photo with enough
   *  room to give up. Below --bp-sm both collapse to the full container
   *  width, as they always did.
   *
   *  A prop rather than a sixth variant, per this file's own rule: the
   *  layout family is identical and only one measurement changes — the same
   *  call `imagePosition` and `minimal`'s `align` already make. */
  cardWidth?: 'default' | 'wide';
  /** split-collage only: images flow alternately into two stacked columns (works with any count >= 1). No wide/offset — each image's own ratio does the sizing. */
  collageImages?: ImageBlock[];
  /** minimal only: content alignment. Default 'left'. */
  align?: 'left' | 'center';
  /** minimal only: optional compact stat row below the CTA (no icon — see StatBand.astro for the icon-bearing full-width version). Omit for the plain text-only look. */
  stats?: HeroStat[];
}

const {
  kicker,
  variant = 'split-mosaic',
  headingLines,
  subheading,
  lead,
  cta,
  logo,
  badges = [],
  images = [],
  image,
  imagePosition = 'left',
  imageFit = 'cover',
  imageFocus = 'center',
  imageWidth = 'default',
  video,
  cardWidth = 'default',
  collageImages = [],
  align = 'left',
  stats = [],
} = Astro.props;

// The breadcrumb trail replaces the kicker. Both sit above the <h1>, and on
// almost every page the kicker only repeated the trail's last crumb ("Home ›
// Commercial cleaning" then "COMMERCIAL CLEANING"). So the kicker shows only
// where there is no trail: the homepage and the 404 page.
const showKicker = kicker && breadcrumbTrail(Astro.url.pathname).length === 0;

const wide = images.find((img) => img.span === 'wide');
const rest = images.filter((img) => img.span !== 'wide');

// Simple alternating two-column split — not a masonry algorithm, just enough
// to turn a flat list into the collage's left/right columns.
const collageColA = collageImages.filter((_, i) => i % 2 === 0);
const collageColB = collageImages.filter((_, i) => i % 2 === 1);
---

{variant === 'split-mosaic' && (
  <section data-cta-location="hero" class="hero hero--split-mosaic" aria-labelledby="hero-heading">
    <div class="container hero__grid">
      <div class="hero__copy">
        <Breadcrumbs />
        {showKicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        {subheading && <p class="hero__subheading">{subheading}</p>}
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'brand'} />

        <div class="hero__badges">
          {badges.map((badge) => (
            <div class="hero__badge">
              <Placeholder ratio={badge.ratio} label={badge.label} />
            </div>
          ))}
        </div>
      </div>

      <div class="hero__mosaic">
        {wide && (
          <div class="hero__mosaic-item hero__mosaic-item--wide">
            <Placeholder ratio={wide.ratio} label={wide.label} src={wide.src} eager />
          </div>
        )}
        <div class="hero__mosaic-row">
          {rest.map((img) => (
            <div class:list={['hero__mosaic-item', { 'hero__mosaic-item--offset': img.offset }]}>
              <Placeholder ratio={img.ratio} label={img.label} src={img.src} eager />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'full-width-photo' && image && (
  <section data-cta-location="hero" class="hero hero--full-width-photo" aria-labelledby="hero-heading">
    <div class="hero__media">
      <Placeholder ratio="16/9" label={image.label} src={image.src} fit={imageFit} eager />
    </div>

    <div class="container">
      {/* Discrete modifier class, not an inline style or an inline custom
          property: the --bp-sm breakpoint has to be able to override this
          width, and inline-origin CSS beats a stylesheet rule at equal
          specificity even when a custom property sits in between. That is
          the ContentGrid.astro gotcha, documented in SECTIONS.md, and it
          applies here for the same reason. */}
      <div class:list={['hero__card', cardWidth === 'wide' && 'hero__card--wide']}>
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        <Breadcrumbs />
        {showKicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        {subheading && <p class="hero__subheading">{subheading}</p>}
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'brand'} />
      </div>
    </div>
  </section>
)}

{variant === 'split-single-image' && (image || video) && (
  <section
    data-cta-location="hero"
    class:list={[
      'hero',
      'hero--split-single',
      { 'hero--split-single-reverse': imagePosition === 'right', 'hero--split-single-wide': imageWidth === 'wide' },
    ]}
    aria-labelledby="hero-heading"
  >
    <div class="hero__grid">
      <div class:list={['hero__media', { 'hero__media--video': video }]}>
        {video ? (
          <div
            class="hero__video"
            style={`--hero-video-ratio: ${video.ratio ?? '9/16'}; --hero-video-frame: ${video.frame ?? video.ratio ?? '9/16'}`}
          >
            {video.src.includes('youtube') ? (
              <div class="hero__yt" data-yt-id={video.src.split('/embed/')[1].split('?')[0]}>
                <img
                  class="hero__yt-poster"
                  src={`https://i.ytimg.com/vi/${video.src.split('/embed/')[1].split('?')[0]}/oardefault.jpg`}
                  alt=""
                  width="720"
                  height="1280"
                  loading="eager"
                />
                <button type="button" class="hero__yt-play" aria-label={`Play: ${video.title}`}>
                  <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                </button>
                <button type="button" class="hero__yt-sound">Tap for sound</button>
              </div>
            ) : (
              <iframe src={video.src} title={video.title} allow="autoplay; fullscreen" allowfullscreen></iframe>
            )}
          </div>
        ) : (
          image && <Placeholder ratio={image.ratio ?? '4/3'} label={image.label} src={image.src} fit={imageFit} focus={imageFocus} eager />
        )}
      </div>

      <div class="hero__copy">
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        <Breadcrumbs />
        {showKicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        {subheading && <p class="hero__subheading">{subheading}</p>}
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'brand'} />
      </div>
    </div>
  </section>
)}

{variant === 'split-collage' && collageImages.length > 0 && (
  <section data-cta-location="hero" class="hero hero--split-collage" aria-labelledby="hero-heading">
    <div class="container hero__grid">
      <div class="hero__copy">
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        <Breadcrumbs />
        {showKicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        {subheading && <p class="hero__subheading">{subheading}</p>}
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'brand'} />
      </div>

      <div class="hero__collage">
        <div class="hero__collage-col">
          {collageColA.map((img) => (
            <div class="hero__collage-item">
              <Placeholder ratio={img.ratio} label={img.label} src={img.src} eager />
            </div>
          ))}
        </div>
        <div class="hero__collage-col">
          {collageColB.map((img) => (
            <div class="hero__collage-item">
              <Placeholder ratio={img.ratio} label={img.label} src={img.src} eager />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'minimal' && (
  <section data-cta-location="hero" class="hero hero--minimal" aria-labelledby="hero-heading">
    <div class="container">
      <div class:list={['hero__content', { 'hero__content--center': align === 'center' }]}>
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        <Breadcrumbs />
        {showKicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        {subheading && <p class="hero__subheading">{subheading}</p>}
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'brand'} />

        {stats.length > 0 && (
          <div class="hero__stats">
            {stats.map((stat) => (
              <div class="hero__stat">
                <span class="hero__stat-value">{stat.value}</span>
                <span class="hero__stat-caption">{stat.caption}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  /* Desktop floor shared by every variant, so a page's hero opens at the same
     height whichever layout it uses — a `minimal` informational hero and the
     homepage's `split-single-image` shouldn't differ in scale just because
     one has a photo. 560px is the value `full-width-photo` already carried on
     its own; it now reads this instead of repeating the literal.

     Each variant applies it to whichever box actually needs to grow: the
     split variants put it on .hero__grid so the ROW stretches and the photo
     panel grows with it (on the section, the row would keep its content
     height and the photo would leave a band of empty background beneath
     itself); `minimal` has no grid, so it goes on the section, which becomes
     a flex container purely to keep the copy centred in the taller band.
     Every variant releases the floor below --bp-lg — on a phone the content
     is already taller than this, and a floor there only risks dead space.
     `full-width-photo` is the exception: its photo IS the background, so it
     keeps a definite (shorter) height on mobile rather than dropping to
     auto. */
  .hero {
    --hero-min-height: 560px;
  }

  /* Eyebrow label above the H1. Sized/spaced to read as a label, not a
     subheading — uppercase with wide tracking is what distinguishes it from
     the lead line below the heading. */
  .hero__kicker {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
    opacity: 0.75;
  }

  /* Demoted headline, directly under the H1. `.hero__copy` is a gap-flex
     column at --space-md, which would space this exactly like the lead and
     leave the H1 and its own second line reading as two unrelated paragraphs.
     The negative margin nets that gap down to --space-xs, so the pair reads as
     one heading block with the lead a clear step below it. Display font at
     lead size: bigger than the lead, smaller than the H1, which is what tells
     the reader it is a headline rather than the first line of body copy. */
  .hero__subheading {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--title-6);
    line-height: var(--leading-snug);
    margin-top: calc(var(--space-xs) - var(--space-md));
    text-wrap: balance;
  }

  /* ---- split-mosaic (default) ------------------------------------------ */

  .hero--split-mosaic {
    background: var(--color-brand);
    padding-block: var(--space-xl);
  }

  .hero--split-mosaic .hero__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-lg);
    align-items: center;
    min-height: var(--hero-min-height);
  }

  .hero--split-mosaic .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    color: var(--color-on-brand);
  }

  .hero--split-mosaic .hero__copy h1 {
    color: var(--color-on-brand);
  }

  .hero--split-mosaic .hero__copy .lead {
    color: var(--color-on-brand);
    max-width: 46ch;
  }

  .hero--split-mosaic .hero__badges {
    display: flex;
    gap: var(--space-sm);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-md);
    margin-top: var(--space-xs);
  }

  .hero--split-mosaic .hero__badge {
    flex: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .hero--split-mosaic .hero__mosaic {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero--split-mosaic .hero__mosaic-item {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hero--split-mosaic .hero__mosaic-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .hero--split-mosaic .hero__mosaic-item--offset {
    transform: translateY(var(--space-md));
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .hero--split-mosaic .hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero--split-mosaic .hero__copy {
      order: 1;
    }

    .hero--split-mosaic .hero__mosaic {
      order: 2;
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--split-mosaic {
      padding-block: var(--space-lg);
    }

    .hero--split-mosaic .hero__badges {
      flex-direction: column;
    }

    .hero--split-mosaic .hero__mosaic-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero--split-mosaic .hero__mosaic-item--offset {
      transform: none;
    }
  }

  /* ---- full-width-photo -------------------------------------------------
     Full-bleed photo behind the section; the card carries its own solid
     --color-surface background, so text contrast never depends on what's in
     the photo underneath it. */

  .hero--full-width-photo {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--hero-min-height);
    /* Keeps a tall card (a long H1, a narrow viewport) off the section's
       bottom edge. Without it the card grows to fill the section and
       TrustBar's card variant, which pulls up over this hero by
       --trust-bar-overlap, lands on it. Must stay larger than that overlap
       at every breakpoint (2.75rem, then 1.5rem below --bp-sm). A short
       card is still centred in the min-height, so this changes nothing for
       it. */
    padding-block: var(--space-xl);
    overflow: hidden;
  }

  .hero--full-width-photo .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero--full-width-photo .container {
    position: relative;
    z-index: 1;
  }

  .hero--full-width-photo .hero__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 480px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .hero--full-width-photo .hero__logo {
    width: 120px;
  }

  .hero--full-width-photo .hero__card .lead {
    max-width: 40ch;
  }

  /* `cardWidth="wide"`. Both rules below tie on specificity with the two
     they override (two classes, then three), so SOURCE ORDER is what makes
     them win — they must stay after the base .hero__card rules and BEFORE
     the --bp-sm block, which has to keep beating them on small screens. */
  .hero--full-width-photo .hero__card--wide {
    max-width: 640px;
  }

  .hero--full-width-photo .hero__card--wide .lead {
    max-width: 52ch;
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--full-width-photo {
      /* Not `auto` like the other variants: this one's photo is the
         background, so it still needs a definite height to be visible at
         all — just a shorter one on a phone. */
      min-height: 420px;
    }

    .hero--full-width-photo .hero__card {
      padding: var(--space-md);
      gap: var(--space-sm);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .hero--full-width-photo {
      padding-block: var(--space-lg);
    }

    .hero--full-width-photo .hero__card {
      max-width: 100%;
    }
  }

  /* ---- split-single-image ------------------------------------------------
     Two flush half-width panels — no container gutter between them, unlike
     split-mosaic which is inset. Grid row height is driven by the copy
     panel's content; the image wrapper stretches to match (grid default
     align-items: stretch) and Placeholder fills it via height:100% +
     object-fit:cover, falling back to its own aspect-ratio once the layout
     collapses to one column on mobile and the row height is no longer
     definite. */

  /* Off White fills the whole section, not each panel, so the two halves read
     as one continuous band with no seam down the middle. It's also the
     backdrop a cut-out asset with real transparency (the homepage's hero
     figure) sits on — Placeholder's --image branch deliberately clears its
     own background. Set explicitly rather than left to inherit the body:
     this variant owns its band colour, same as every other variant here.
     Invisible under an opaque cover photo either way. */
  .hero--split-single {
    background: var(--color-surface);
    /* The inset that puts this hero's copy on the same vertical line as every
       .container section on the page. .container is `max-width: --container;
       margin-inline: auto; padding-inline: --space-md`, so its content edge
       sits at max(--space-md, (page - --container) / 2 + --space-md) from the
       page edge. This hero is full-bleed by design — the photo runs off the
       viewport edge — so the copy side has to reproduce that line itself,
       which it does as an empty grid track below.

       Percentages in a track size resolve against the grid container's own
       inline size, and this grid spans the full page width — the same basis
       .container measures from. That's why this isn't written with 100vw:
       100vw includes the scrollbar, which .container's `margin: auto` does
       not, so a vw-based gutter would sit ~half a scrollbar off. */
    --hero-gutter: max(var(--space-md), calc((100% - var(--container)) / 2 + var(--space-md)));
  }

  /* photo | copy | gutter. The photo bleeds off the outer edge; the copy's
     far edge lands on the container line. Mirrored under -reverse below. */
  .hero--split-single .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr var(--hero-gutter);
    /* The copy panel's own justify-content: center keeps the text optically
       centred in whatever height wins. See --hero-min-height at the top of
       this sheet for why the floor sits on the grid, not the section. */
    min-height: var(--hero-min-height);
  }

  /* Both panels are pinned to row 1. Without an explicit row, auto-placement
     walks forward only: -reverse puts the DOM-first .hero__media in column 3,
     which parks the cursor past column 2, so .hero__copy gets bumped to a
     second row and the hero renders as a diagonal stair instead of a split. */
  .hero--split-single .hero__media {
    grid-column: 1;
    grid-row: 1;
    overflow: hidden;
    /* Keep an empty image slot on the section's own band colour instead of
       Placeholder's default Cream, which would split this hero into two
       different-coloured halves — the exact seam the section-level
       background above exists to avoid. Tracks --color-surface rather than
       restating it, so the two can't drift apart. The dashed border still
       marks the slot as unfilled. No effect once `src` is set: the image
       branch keeps no background of its own. */
    --placeholder-bg: var(--color-surface);
  }

  /* `video`: the player sits centred in the panel at the video's own shape
     rather than filling the panel edge to edge. A full-panel iframe would
     letterbox a portrait reel inside black bars; this keeps the bars off the
     page and the band colour around it.

     Sized by WIDTH, not by the copy's height. Google Drive's player mis-frames
     a portrait video below about 360px wide (checked in the browser: a black
     strip down one side and the burnt-in captions clipped at 243px and 281px,
     clean at 360px). A 9/16 frame at 360px is 640px tall, so the hero grows
     past --hero-min-height to hold it. */
  .hero--split-single .hero__media--video {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Extra room at the bottom: TrustBar's card row pulls up over the hero by
       --trust-bar-overlap (2.75rem, set in TrustBar.astro), which cut into the
       bottom of the video. Keep this in step if that value changes. */
    padding-block: var(--space-lg) calc(var(--space-lg) + 2.75rem);
  }

  .hero__video {
    position: relative;
    width: 360px;
    max-width: 100%;
    aspect-ratio: var(--hero-video-frame);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #11191C;
  }

  /* The player always keeps the video's own shape and is centred top to
     bottom in the frame. With no `frame` the two shapes match and it fills
     the frame exactly; with a squatter `frame` the overflow: hidden above
     crops the same amount off the top and the bottom. */
  .hero__video iframe {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    aspect-ratio: var(--hero-video-ratio);
    transform: translateY(-50%);
    border: 0;
  }

  .hero--split-single .hero__copy {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-md);
    /* Inner edge (facing the photo) gets the full --space-xl gap; the outer
       edge gets nothing, because the gutter track beside it is already
       holding exactly the container's inset. Padding there too would push
       the copy inside the line everything else lines up on. */
    padding-block: var(--space-xl);
    padding-inline: var(--space-xl) 0;
    min-width: 0;
  }

  .hero--split-single .hero__logo {
    width: 120px;
    flex-shrink: 0;
  }

  .hero--split-single .hero__copy .lead {
    max-width: 42ch;
  }

  /* imagePosition="right" — mirror all three tracks, gutter now leading:
     gutter | copy | photo. Desktop only; the --bp-lg block below collapses
     both positions to one column and orders copy first there. */
  .hero--split-single-reverse .hero__grid {
    grid-template-columns: var(--hero-gutter) 1fr 1fr;
  }

  .hero--split-single-reverse .hero__copy {
    grid-column: 2;
    padding-inline: 0 var(--space-xl);
  }

  .hero--split-single-reverse .hero__media {
    grid-column: 3;
  }

  /* imageWidth="wide": the photo track grows, the copy track keeps 1fr.
     Desktop only, inside a min-width query, because the -reverse compound
     selector outranks the --bp-lg one-column rule below and would otherwise
     keep the split on mobile. */
  @media (min-width: 1026px) {
    .hero--split-single-wide .hero__grid {
      grid-template-columns: 1.5fr 1fr var(--hero-gutter);
    }

    .hero--split-single-wide.hero--split-single-reverse .hero__grid {
      grid-template-columns: var(--hero-gutter) 1fr 1.5fr;
    }

    /* A photo bleeds off the page edge, but a video player is content and
       should stay inside the container line like the copy does. Without
       this the player centres in the full-bleed half and, on a wide screen,
       lands well past where every other section's content stops. Padding
       the outer side by the gutter centres it between the copy and that
       line instead.

       --hero-gutter can't be reused here: its 100% means the page width in
       the grid template, but in padding it would mean this panel's width.
       So the hero becomes a size container and the same sum is written in
       cqw, which is the hero's full width wherever it is used. */
    .hero--split-single:has(.hero__media--video) {
      container-type: inline-size;
      --hero-video-gutter: max(var(--space-md), calc((100cqw - var(--container)) / 2 + var(--space-md)));
    }

    .hero--split-single .hero__media--video {
      padding-inline-start: var(--hero-video-gutter);
    }

    .hero--split-single-reverse .hero__media--video {
      padding-inline: 0 var(--hero-video-gutter);
    }
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .hero--split-single .hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    /* Drop the desktop placement entirely. An explicit `grid-column: 2` (or
       3) in a one-column grid doesn't clamp — it generates implicit columns
       and the layout silently goes back to being side-by-side. The row reset
       matters just as much: leaving both panels pinned to `grid-row: 1` would
       stack them on top of each other in the same cell. One column, rows
       auto-placed, `order` below deciding which comes first. */
    .hero--split-single .hero__media,
    .hero--split-single .hero__copy {
      grid-column: 1;
      grid-row: auto;
    }

    /* Copy first on mobile — the message and CTA shouldn't sit below a
       full-width image on a small screen. */
    .hero--split-single .hero__media {
      order: 2;
    }

    /* One column, so there's no gutter track and no inner edge to hold off
       from: the copy carries the container's own --space-md inset directly.
       Shorthand deliberately, to clear the desktop padding-inline pair. */
    .hero--split-single .hero__copy {
      order: 1;
      padding: var(--space-lg) var(--space-md);
    }

    /* One column: the player sits under the copy with the container's inset. */
    .hero--split-single .hero__media--video {
      padding: 0 var(--space-md) calc(var(--space-lg) + 2.75rem);
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--split-single .hero__copy {
      padding: var(--space-md);
    }
  }

  /* ---- split-collage -----------------------------------------------------
     Copy panel (same neutral treatment as split-single-image, not the
     brand-yellow fill split-mosaic uses) + a static two-column image
     collage. Explicitly NOT an interactive carousel — the wireframe this
     was built from was labelled "Carousel Image" but its own description
     and visual both show a fixed collage; see SECTIONS.md for that call. */

  .hero--split-collage .hero__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-lg);
    align-items: center;
    min-height: var(--hero-min-height);
  }

  .hero--split-collage .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    /* Same block padding as split-single-image. Without it a tall copy
       column (a long H1) runs to the section's bottom edge, and the card
       TrustBar's --trust-bar-overlap pull then covers the CTA button. */
    padding-block: var(--space-xl);
  }

  .hero--split-collage .hero__copy .lead {
    max-width: 46ch;
  }

  .hero--split-collage .hero__logo {
    width: 120px;
  }

  .hero--split-collage .hero__collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    align-items: start;
  }

  .hero--split-collage .hero__collage-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero--split-collage .hero__collage-item {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .hero--split-collage .hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    /* The collage follows the copy here, so the overlap lands on the
       images rather than the button. Spacing stays as it was. */
    .hero--split-collage .hero__copy {
      order: 1;
      padding-block: 0;
    }

    .hero--split-collage .hero__collage {
      order: 2;
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--split-collage .hero__grid {
      gap: var(--space-md);
    }
  }

  /* ---- minimal -------------------------------------------------------------
     Text-only: headline + lead + CTA, no image. --color-surface-muted gives
     it a faint tint distinct from the page's white background, matching the
     wireframe, without being a brand-colour band like split-mosaic. */

  .hero--minimal {
    background: var(--color-surface-muted);
    padding-block: var(--space-2xl);
    /* Flex purely to centre the single .container child inside the floor —
       without it the copy would sit at the top of a 560px band. */
    min-height: var(--hero-min-height);
    display: flex;
    align-items: center;
  }

  .hero--minimal .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: var(--container-narrow);
  }

  .hero--minimal .hero__content--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .hero--minimal .hero__logo {
    width: 120px;
  }

  .hero--minimal .lead {
    max-width: 60ch;
  }

  .hero--minimal .hero__stats {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-muted);
  }

  .hero--minimal .hero__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-inline-start: var(--space-lg);
    border-left: 1px solid var(--color-border-muted);
  }

  .hero--minimal .hero__stat:first-child {
    padding-inline-start: 0;
    border-left: none;
  }

  .hero--minimal .hero__stat-value {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--title-6);
    color: var(--color-on-surface);
  }

  .hero--minimal .hero__stat-caption {
    font-size: var(--text-small);
    color: var(--color-body);
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .hero--minimal {
      min-height: auto;
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--minimal {
      padding-block: var(--space-xl);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .hero--minimal .hero__stats {
      flex-direction: column;
      gap: var(--space-sm);
      width: 100%;
    }

    .hero--minimal .hero__stat {
      padding-inline-start: 0;
      border-left: none;
      padding-top: var(--space-sm);
      border-top: 1px solid var(--color-border-muted);
    }

    .hero--minimal .hero__stat:first-child {
      padding-top: 0;
      border-top: none;
    }
  }

  /* YouTube hero video: a poster (the video's own still) with a play button,
     so the panel is never a blank box. It starts playing muted once it is in
     view, "Tap for sound" turns the sound on, and when it ends it goes back
     to the same poster (script at the bottom of this file). The poster and
     the player both keep the video's own shape, centred in the frame, so the
     handover from still to video does not jump. Elements the YouTube API adds
     have no Astro scope attribute, hence :global on the iframe. */
  .hero__yt {
    position: absolute;
    inset: 0;
  }

  .hero__yt-poster,
  .hero__yt :global(iframe) {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: auto;
    aspect-ratio: var(--hero-video-ratio);
    transform: translateY(-50%);
    border: 0;
    object-fit: cover;
  }

  .hero__yt :global(iframe) {
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hero__yt.is-playing :global(iframe) {
    opacity: 1;
  }

  .hero__yt-play {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 72px;
    height: 72px;
    margin: auto;
    display: grid;
    place-items: center;
    padding: 0 0 0 4px;
    border: 0;
    border-radius: 50%;
    background: rgb(17 25 28 / 0.72);
    color: #fff;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .hero__yt-play:hover,
  .hero__yt-play:focus-visible {
    transform: scale(1.06);
    background: var(--tlb-green, #1f6b4f);
  }

  .hero__yt.is-playing .hero__yt-play {
    display: none;
  }

  .hero__yt-sound {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: var(--space-md, 16px);
    transform: translateX(-50%);
    display: none;
    padding: 8px 16px;
    border: 0;
    border-radius: 999px;
    background: rgb(17 25 28 / 0.78);
    color: #fff;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .hero__yt.is-playing .hero__yt-sound {
    display: block;
  }
</style>

<script>
  // YouTube hero video: starts 2 seconds after the page opens, tries sound
  // first and falls back to muted with "Tap for sound" (see src/lib/yt-video.ts).
  import { initYtVideos } from '../../lib/yt-video';
  initYtVideos({ block: '.hero__yt', play: '.hero__yt-play', sound: '.hero__yt-sound' });
</script>

