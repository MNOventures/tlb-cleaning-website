---
import '../styles/reset.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

// Preload the display face used for H1 (Poppins 700) so the largest,
// earliest text on the page doesn't wait on font discovery via the CSS.
import poppinsBoldWoff2 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';

// Every page on the site reaches this layout, so this import is the one place
// the noindex decision has to be made. See site-env.ts for why it fails closed.
import { isStaging, robotsContent, siteEnv } from '../data/site-env';
import { isIndexable } from '../data/indexing';
import { breadcrumbTrail } from '../data/breadcrumbs';
import type { PageSchema } from '../data/schema';

export interface LocalBusinessInfo {
  name: string;
  /** Other names the business is known by, so Google ties them to one entity. */
  alternateName: string[];
  url: string;
  logo: string;
  telephone: string;
  email: string;
  /** Service-area business: the street address is hidden on Google, so only
   *  the parts TLB chooses to show are given. Empty parts are left out. */
  address: {
    streetAddress?: string;
    addressLocality?: string;
    addressRegion?: string;
    postalCode?: string;
    addressCountry: string;
  };
  openingHours: { dayOfWeek: string[]; opens: string; closes: string }[];
  sameAs: string[];
  areaServed: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  business: LocalBusinessInfo;
  /** Keep this page out of search on production too. For pages a reader only
   *  reaches by doing something, like /thank-you/ after a form submit. */
  noindex?: boolean;
  /** The page's JSON-LD graph, from schema.ts' `pageSchema()`. When given it
   *  is the page's only structured data, and `business` just names the site
   *  for Open Graph. Pages without one get the LocalBusiness block below. */
  schema?: PageSchema;
}

const { title, description, canonical, ogImage, business, noindex = false, schema } = Astro.props;

// Production only (staging is blanket-noindexed below). A page asks for noindex
// itself, or indexing.ts rules it out because nothing in the menu links it yet.
// integrations/sitemap.mjs reads this tag back out of the built HTML, so a page
// with it can never appear in sitemap.xml.
const excludeFromIndex = noindex || !isIndexable(Astro.url.pathname);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  alternateName: business.alternateName,
  url: business.url,
  logo: business.logo,
  image: ogImage ?? business.logo,
  telephone: business.telephone,
  email: business.email,
  description: business.description,
  areaServed: business.areaServed,
  address: {
    '@type': 'PostalAddress',
    ...Object.fromEntries(Object.entries(business.address).filter(([, value]) => value)),
  },
  openingHoursSpecification: business.openingHours.map((hours) => ({
    '@type': 'OpeningHoursSpecification',
    ...hours,
  })),
  sameAs: business.sameAs,
};

// The breadcrumb trail as JSON-LD, for pages without a `schema` (a schema
// carries its own). Built from the same breadcrumbTrail() the visible trail in
// Breadcrumbs.astro uses, so the two cannot disagree.
const trail = breadcrumbTrail(Astro.url.pathname);
const breadcrumbJsonLd = trail.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: trail.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.label,
        item: new URL(crumb.href, Astro.site).href,
      })),
    }
  : null;

// Google Tag Manager. One container across both environments; the ID is not a
// secret, so it lives here rather than in an env var.
const GTM_CONTAINER_ID = 'GTM-KDMCQNN9';

// Pushed BEFORE the container loads, so siteEnv is already on the dataLayer
// when GTM fires its very first event and every tag can read it.
const dataLayerInit = `window.dataLayer = window.dataLayer || [];
window.dataLayer.push({ siteEnv: '${siteEnv}' });`;

// Googles snippet verbatim, with the container ID interpolated.
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${GTM_CONTAINER_ID}');`;
import QuoteTab from '../components/ui/QuoteTab.astro';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Google Tag Manager, as high in the head as the document allows: only
        charset and viewport go above it, and both have to, because they change
        how the rest of the document is parsed and laid out.

        ⚠️ GTM LOADS ON STAGING TOO, on purpose, so tags can be tested there
        with Preview mode. What keeps staging traffic out of GA4 and Ads is a
        blocking exception on siteEnv === "staging", and THAT EXCEPTION LIVES IN
        THE GTM UI, NOT IN THIS REPO. It is not version controlled and nothing
        here can verify it. If it is removed or never configured, staging
        silently starts reporting as real traffic. The noindex in this same head
        does not help with that: indexing and tag firing are unrelated.

        is:inline on both, for the same reason as the JSON-LD below: without it
        Astro bundles, hashes and relocates the script, which loses the position
        the snippet depends on. */}
    <script is:inline set:html={dataLayerInit} />
    <!-- Google Tag Manager -->
    <script is:inline set:html={gtmSnippet} />
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Staging only. The canonical above deliberately still points at the
        production domain — with noindex present that is harmless, and it keeps
        staging and production markup identical apart from this one line. */}
    {isStaging ? (
      <meta name="robots" content={robotsContent} />
    ) : (
      excludeFromIndex && <meta name="robots" content="noindex, follow" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={business.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="theme-color" content="#234B51" />
    {/* Favicon set lives in public/ and is served from the site root. The
        .ico carries the legacy/desktop sizes; the PNGs are what modern
        browsers actually pick, and apple-touch-icon is the iOS home screen.
        No .svg in the set — the one that used to sit here was the previous
        brand's placeholder mark. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={poppinsBoldWoff2} as="font" type="font/woff2" crossorigin />

    {schema ? (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    ) : (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
        {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />}
      </>
    )}

    {/* Simple Commenter, STAGING ONLY. Supplied by the client as a
        paste-into-the-head snippet and reproduced verbatim. The `id` is a
        public site identifier rather than a secret, so it lives here like the
        GTM container ID above.

        It is a review tool: it exists so the client can leave comments on the
        staging site while the build is being signed off. Production visitors
        must never see it, so it is gated on `isStaging` from site-env.ts
        rather than kept as a difference between the staging and main branches.
        A branch diff would have to be re-resolved on every single merge, and
        the one time it got resolved the wrong way the snippet would ship to
        real customers. This way there is one codebase and the environment
        decides, on the same flag that already decides indexability.

        Because `isStaging` is the inverse of a SITE_ENV === 'production' check,
        this inherits that flag's fail-closed behaviour in the safe direction:
        a build with SITE_ENV unset or misspelt gets the commenter, and only a
        correct production build drops it.

        Last in the head and `defer`red, so it cannot block parsing or delay
        first paint. It has no position dependency the way the GTM snippet
        does, and nothing else in the document reads from it.

        is:inline for the same reason as the two scripts above: without it
        Astro takes ownership of the tag, and a bundled or relocated loader is
        no longer the snippet the vendor supports. */}
    {isStaging && (
      <script src="https://simplecommenter.com/js/comments.min.js?id=sc_605325550fe4c323" defer is:inline
      ></script>
    )}
  </head>
  <body>
    {/* Google Tag Manager noscript fallback. Google requires it immediately
        after the opening <body>. It is display:none and zero-sized, so it stays
        out of the skip links focus order and adds nothing visible. */}
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_CONTAINER_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
    {/* Sticky quote tab: follows the visitor and jumps to the quote form (#enquiry). */}
    <QuoteTab />
    {/* Your Digital Office chat widget. Supplied by the vendor as a
        paste-before-</body> snippet and reproduced verbatim; `client` is a
        public identifier, not a secret. Unlike Simple Commenter it is for real
        visitors, so it loads on every environment. is:inline for the same
        reason as the head scripts: Astro must not bundle or move the loader. */}
    <script src="https://api.yourdigitaloffice.com.au/widget.js?client=tlb-cleaning" is:inline></script>
  </body>
</html>
